NODE_ENV=development
PORT=4002

# Postgres - SAMA PERSIS dengan apivisitor (visitor_app_db), bukan instance
# terpisah. Exhibitor app baca/tulis tabel yang sama (chat_message,
# exhibitor_member_status_sync, exhibitor_app_meeting_action, dst).
DB_HOST=
DB_PORT=5432
DB_USERNAME=visitor_app
DB_PASSWORD=
DB_NAME=visitor_app_db
DB_SYNCHRONIZE=false
DB_LOGGING=false

JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

SWAGGER_ENABLED=true

# Firebase (FCM push notification) - project SAMA dengan apivisitor,
# file service account SAMA (lihat /home/undangin/secrets/ di server).
FIREBASE_SERVICE_ACCOUNT_PATH=

# Redis - BELUM DIPAKAI kode aktif sekarang. Disiapkan untuk fase
# selanjutnya: @socket.io/redis-adapter, biar broadcast ChatGateway
# (chat:message, chat:typing) beneran real-time lintas server dengan
# apivisitor (yang juga bakal pakai variable nama sama, instance Redis
# yang sama). Isi kalau/waktu fase itu mulai dikerjakan.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
